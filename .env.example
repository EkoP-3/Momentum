# Momentum şu an hiçbir ortam değişkeni GEREKTİRMEZ: tüm veriler cihazda tutulur.
# Aşağıdakiler yalnızca ileride Supabase (hesap/senkron/satın alma doğrulama) eklenirse içindir.
# Gerçek değerleri .env dosyasına yaz — .env git'e GİRMEZ (.gitignore'da).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ASLA VITE_ önekiyle yazma ve istemciye gömme: service_role anahtarı yalnızca sunucuda durur.
# SUPABASE_SERVICE_ROLE_KEY=
